generator client {
 provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model my_users{
	id Int @id @default(autoincrement())
	name String @db.VarChar(20) @unique @map("Name")
	email String @db.VarChar(20) @unique @map("Email")
	password String @map("Password")
	createdAt DateTime @default(now())
}



