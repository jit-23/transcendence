generator client {
 provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConversationType {
  DIRECT
  GROUP
}

model my_users{
	id Int @id @default(autoincrement())
	name String @db.VarChar(50) @unique @map("Name")
	email String @db.VarChar(100) @unique @map("Email")
	password String? @map("Password")
	createdAt DateTime @default(now())
	twoFactorEnabled Boolean @default(false)
	twoFactorSecret String?
	avatar           String?
	googleId         String? @unique
	fortyTwoId       String? @unique

	conversations conversation_participants[]
	messages message[]
	sentRequests friend_request[] @relation("SentRequests")
	receivedRequests friend_request[] @relation("ReceivedRequests")
	canvases canvas[]
	canvasCollaborations canvas_collaborator[]

}

model conversation {
	id 			Int 			@id @default(autoincrement())
	type 		ConversationType @default(DIRECT)
	name        String?
	created_at	DateTime 	@default(now())

	participants conversation_participants[]
	messages    message[]

}



model conversation_participants {
	conversation_id 	Int
    user_id				Int
	joinedAt 			DateTime @default(now())
    joined_at 			DateTime @default(now())
    role 				String

	conversation conversation @relation(fields: [conversation_id], references: [id])
  	user         my_users @relation(fields: [user_id], references: [id])

	@@id([conversation_id, user_id])
}

model friend_request {
	id Int @id @default(autoincrement())
	senderId Int
	receiverId Int
	status String @default("pending")
	createdAt DateTime @default(now())

	sender my_users @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
	receiver my_users @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

	@@unique([senderId, receiverId])
}

model message {
	id Int @id @default(autoincrement())
	conversation_id Int
	sender_id Int
	content String
	created_at DateTime @default(now())

	conversation conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
	sender my_users @relation(fields: [sender_id], references: [id], onDelete: Cascade)
}

model canvas {
	id Int @id @default(autoincrement())
	userId Int
	name String @db.VarChar(100)
	content String? @db.Text
	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	user my_users @relation(fields: [userId], references: [id], onDelete: Cascade)
	collaborators canvas_collaborator[]
}

model canvas_collaborator {
	canvasId Int
	userId Int
	addedAt DateTime @default(now())

	canvas canvas @relation(fields: [canvasId], references: [id], onDelete: Cascade)
	user my_users @relation(fields: [userId], references: [id], onDelete: Cascade)

	@@id([canvasId, userId])
}